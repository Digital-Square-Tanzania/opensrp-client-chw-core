<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="63dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="15dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:importantForAccessibility="no"
        android:text="@string/navigation_other_modules"
        android:textColor="@color/navigation_item_unselected"
        android:textSize="@dimen/navigation_section_text_size" />

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_navigation_expand" />
</LinearLayout>
